# --- LLM (Claude) ---
# ANTHROPIC_API_KEY 대신 `ant auth login` 프로필을 써도 됩니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- 2-1 Explorer: Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- 2-2 Retriever: 벡터 DB (Chroma) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=source_code

# --- 4 Composer: 산출물 저장 경로 ---
REPORT_DIR=./outputs/reports
