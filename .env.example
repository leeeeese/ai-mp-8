# --- LLM (OpenAI) --- Planner, Explorer·Retriever ReAct 보완 단계가 사용 (REACT=0 이면 ReAct 끔)
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-sol
# 응답 편차를 줄이는 고정 seed (빈 값이면 끔). 이 모델은 temperature 를 기본값만 받아 고정하지 않는다
LLM_SEED=7
# Azure OpenAI 호환 게이트웨이를 쓰면 (예: 사내 ai-talentlab)
# AZURE_OPENAI_ENDPOINT=https://skax.ai-talentlab.com
# OPENAI_API_VERSION=2024-12-01-preview

# --- 2-1 Explorer: Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# GRAPH_BACKEND=csv          # Neo4j 없이 data/graph/*.csv 로 탐색 (개발·테스트용, 기본 neo4j)

# --- 2-2 Retriever: 원본 소스·문서 직접 조회 (영역별 루트, SM 선택으로 결정) ---
# 그래프 노드의 source_file 은 해당 영역 SOURCE_ROOT 기준 상대경로
SOURCE_ROOT_TOS=./data/source/tos
SOURCE_ROOT_SWING=./data/source/swing
DOCS_ROOT_TOS=./data/docs/tos
DOCS_ROOT_SWING=./data/docs/swing
SNAPSHOT_ROOT_TOS=./data/snapshot/tos

# --- 4 Composer: 산출물 저장 경로 ---
REPORT_DIR=./outputs/reports

# --- 실행 로그: 터미널 출력 수준 (UI·outputs/logs 는 항상 전체) ---
# full 이면 터미널에도 에이전트별 전체 블록 (받은 입력 → 동작(LLM 판정·ReAct·규칙 보정) → 근거 → 결과). 비우면 진행 요약만
AGENT_LOG=
