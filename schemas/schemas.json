{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImpactAnalysisAgentSchemas",
  "constants": {
    "MAX_EXPLORE_LOOP": 3,
    "MAX_HOPS": 3,
    "MAX_REPLAN": 2,
    "MAX_TOOL_CALLS": 20,
    "MEMORY_WINDOW_N": 5,
    "KPI_MIN_RECALL": 0.8,
    "KPI_MIN_PRECISION": 0.5
  },
  "$defs": {
    "Difficulty": {
      "enum": [
        "Major",
        "Medium",
        "Minor"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "Feasibility": {
      "enum": [
        "feasible",
        "hard",
        "review"
      ],
      "title": "Feasibility",
      "type": "string"
    },
    "Alternative": {
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "feasibility": {
          "$ref": "#/$defs/Feasibility"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "pros_cons": {
          "title": "Pros Cons",
          "type": "string"
        }
      },
      "required": [
        "description",
        "feasibility",
        "difficulty",
        "pros_cons"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Area": {
      "enum": [
        "screen",
        "db",
        "interface",
        "batch"
      ],
      "title": "Area",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "confirmed",
        "inferred"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ImpactPath": {
      "properties": {
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "hops": {
          "description": "A→C→X 순서",
          "items": {
            "$ref": "#/$defs/PathHop"
          },
          "title": "Hops",
          "type": "array"
        },
        "cross_domain": {
          "default": false,
          "description": "상품↔마케팅 도메인 간 연계 여부",
          "title": "Cross Domain",
          "type": "boolean"
        }
      },
      "required": [
        "path_id",
        "hops"
      ],
      "title": "ImpactPath",
      "type": "object"
    },
    "ImpactType": {
      "enum": [
        "add",
        "modify",
        "reference_only",
        "none"
      ],
      "title": "ImpactType",
      "type": "string"
    },
    "PathHop": {
      "description": "'노드 → 관계 → 영향 → 근거' 한 hop.",
      "properties": {
        "node": {
          "title": "Node",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "impact": {
          "title": "Impact",
          "type": "string"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evidence 식별 (file_path#symbol)",
          "title": "Evidence Ref"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "node",
        "relation",
        "impact",
        "confidence"
      ],
      "title": "PathHop",
      "type": "object"
    },
    "AreaImpact": {
      "properties": {
        "area": {
          "$ref": "#/$defs/Area"
        },
        "impact_type": {
          "$ref": "#/$defs/ImpactType"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/ImpactPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "feasibility": {
          "$ref": "#/$defs/Feasibility"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "difficulty_basis": {
          "description": "사전 확정한 난이도 판단 기준 중 적용한 항목",
          "title": "Difficulty Basis",
          "type": "string"
        },
        "schedule_factors": {
          "items": {
            "type": "string"
          },
          "title": "Schedule Factors",
          "type": "array"
        },
        "infeasible_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Infeasible Reason"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "area",
        "impact_type",
        "paths",
        "feasibility",
        "difficulty",
        "difficulty_basis",
        "confidence"
      ],
      "title": "AreaImpact",
      "type": "object"
    },
    "AreaVerdictRow": {
      "description": "영역별 판정표 한 행.",
      "properties": {
        "area": {
          "$ref": "#/$defs/Area"
        },
        "impact_path_summary": {
          "title": "Impact Path Summary",
          "type": "string"
        },
        "feasibility": {
          "$ref": "#/$defs/Feasibility"
        },
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence_names": {
          "description": "노드·테이블명·소스 위치",
          "items": {
            "type": "string"
          },
          "title": "Evidence Names",
          "type": "array"
        }
      },
      "required": [
        "area",
        "impact_path_summary",
        "feasibility",
        "difficulty",
        "confidence",
        "evidence_names"
      ],
      "title": "AreaVerdictRow",
      "type": "object"
    },
    "ChecklistOwner": {
      "enum": [
        "business",
        "developer"
      ],
      "title": "ChecklistOwner",
      "type": "string"
    },
    "ChecklistStatus": {
      "enum": [
        "confirmed",
        "unconfirmed"
      ],
      "title": "ChecklistStatus",
      "type": "string"
    },
    "ChecklistItem": {
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/ChecklistOwner"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "status": {
          "$ref": "#/$defs/ChecklistStatus",
          "default": "unconfirmed"
        },
        "related_area": {
          "anyOf": [
            {
              "$ref": "#/$defs/Area"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "item_id",
        "owner",
        "question"
      ],
      "title": "ChecklistItem",
      "type": "object"
    },
    "ComplexReport": {
      "properties": {
        "summary_conclusion": {
          "title": "Summary Conclusion",
          "type": "string"
        },
        "area_verdicts": {
          "items": {
            "$ref": "#/$defs/AreaVerdictRow"
          },
          "title": "Area Verdicts",
          "type": "array"
        },
        "schedule_factors": {
          "items": {
            "type": "string"
          },
          "title": "Schedule Factors",
          "type": "array"
        },
        "path_details": {
          "items": {
            "$ref": "#/$defs/ImpactPath"
          },
          "title": "Path Details",
          "type": "array"
        },
        "analysis_limits": {
          "items": {
            "type": "string"
          },
          "title": "Analysis Limits",
          "type": "array"
        },
        "checklist": {
          "items": {
            "$ref": "#/$defs/ChecklistItem"
          },
          "title": "Checklist",
          "type": "array"
        },
        "stage": {
          "default": "initial",
          "enum": [
            "initial",
            "updated",
            "final_for_dev"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "summary_conclusion",
        "area_verdicts",
        "schedule_factors",
        "path_details",
        "analysis_limits",
        "checklist"
      ],
      "title": "ComplexReport",
      "type": "object"
    },
    "Complexity": {
      "enum": [
        "simple",
        "complex"
      ],
      "title": "Complexity",
      "type": "string"
    },
    "GuidanceQuery": {
      "properties": {
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "sql": {
          "description": "읽기 전용(SELECT)만 허용",
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "sql"
      ],
      "title": "GuidanceQuery",
      "type": "object"
    },
    "QueryResultSummary": {
      "properties": {
        "code_meanings": {
          "items": {
            "type": "string"
          },
          "title": "Code Meanings",
          "type": "array"
        },
        "main_causes": {
          "items": {
            "type": "string"
          },
          "title": "Main Causes",
          "type": "array"
        },
        "inquiry_items": {
          "description": "문의 필요 항목",
          "items": {
            "type": "string"
          },
          "title": "Inquiry Items",
          "type": "array"
        }
      },
      "title": "QueryResultSummary",
      "type": "object"
    },
    "ReanalysisRequest": {
      "description": "Composer → Supervisor. 답변 반영으로 영향 경로 자체가 바뀌어야 할 때.",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "changed_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Changed Assumptions",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "changed_assumptions"
      ],
      "title": "ReanalysisRequest",
      "type": "object"
    },
    "SimpleAnswer": {
      "properties": {
        "conclusion_lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 3,
          "title": "Conclusion Lines",
          "type": "array"
        },
        "evidence_table": {
          "items": {
            "$ref": "#/$defs/SimpleEvidenceRow"
          },
          "title": "Evidence Table",
          "type": "array"
        },
        "check_queries": {
          "items": {
            "$ref": "#/$defs/GuidanceQuery"
          },
          "title": "Check Queries",
          "type": "array"
        },
        "inquiry_contacts": {
          "items": {
            "type": "string"
          },
          "title": "Inquiry Contacts",
          "type": "array"
        },
        "analysis_limits": {
          "items": {
            "type": "string"
          },
          "title": "Analysis Limits",
          "type": "array"
        },
        "detail_analysis_recommended": {
          "default": false,
          "description": "변경 요소가 보이면 True",
          "title": "Detail Analysis Recommended",
          "type": "boolean"
        },
        "query_result_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryResultSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "conclusion_lines",
        "evidence_table"
      ],
      "title": "SimpleAnswer",
      "type": "object"
    },
    "SimpleEvidenceRow": {
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "claim",
        "evidence",
        "confidence"
      ],
      "title": "SimpleEvidenceRow",
      "type": "object"
    },
    "ComposerOutput": {
      "properties": {
        "complexity": {
          "$ref": "#/$defs/Complexity"
        },
        "complex_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComplexReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simple_answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimpleAnswer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reanalysis_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReanalysisRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mail_draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/MailDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF/MD 저장 경로 (요청 시, save_report 결과)",
          "title": "Report File Path"
        },
        "markdown": {
          "description": "템플릿 렌더링 결과 (사용자 표시용)",
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "complexity",
        "markdown"
      ],
      "title": "ComposerOutput",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "swing",
        "tos"
      ],
      "title": "Domain",
      "type": "string"
    },
    "NodeLabel": {
      "description": "영향도 그래프 노드 유형. 단계(depth): 0 Screen / 1 Controller·TP·Batch / 2 Service·Module·DBIO / 3 SQL·DBIO / 4 Table / 5 Column. tos: Controller·Service·SQL, swing: TP·Module, 공통: Screen·Batch·DBIO·Table·Column",
      "enum": [
        "Screen",
        "Controller",
        "TP",
        "Batch",
        "Service",
        "Module",
        "DBIO",
        "SQL",
        "Table",
        "Column"
      ],
      "title": "NodeLabel",
      "type": "string"
    },
    "EdgeType": {
      "description": "영향도 그래프 엣지 유형. CALLS: Screen→Controller/TP, TP→TP / INVOKES: 로직→로직·DBIO / EXECUTES: Service·Batch→SQL / READS·WRITES: DBIO·SQL→Table / REFERENCES: Table→Table / HAS_COLUMN: Table→Column",
      "enum": [
        "CALLS",
        "INVOKES",
        "EXECUTES",
        "READS",
        "WRITES",
        "REFERENCES",
        "HAS_COLUMN"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "TraverseDirection": {
      "enum": [
        "downstream",
        "upstream"
      ],
      "title": "TraverseDirection",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "라인 범위/화면 ID 등",
          "title": "Location"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "source",
            "screen",
            "interface_spec",
            "common_code",
            "ops_doc"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Domain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "file_path",
        "summary",
        "source_kind"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExpandGraphInput": {
      "properties": {
        "node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "hops": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Hops",
          "type": "integer"
        },
        "direction": {
          "$ref": "#/$defs/TraverseDirection",
          "default": "downstream"
        },
        "rel_types": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/EdgeType"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rel Types"
        }
      },
      "required": [
        "node_ids"
      ],
      "title": "ExpandGraphInput",
      "type": "object"
    },
    "GraphEdge": {
      "properties": {
        "from_id": {
          "title": "From Id",
          "type": "string"
        },
        "to_id": {
          "title": "To Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType",
          "description": "엣지 유형 (EdgeType)"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties",
          "description": "엣지 속성 (event: 화면 이벤트, via: 참조 컬럼, columns: DBIO 가 접근하는 컬럼 목록 등)"
        }
      },
      "required": [
        "from_id",
        "to_id",
        "type"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/NodeLabel",
          "description": "노드 유형 (NodeLabel)"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/Domain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "required": [
        "node_id",
        "name",
        "label"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "ExpandGraphOutput": {
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "ExpandGraphOutput",
      "type": "object"
    },
    "StartNodeChoice": {
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "matched_keyword": {
          "title": "Matched Keyword",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "matched_keyword",
        "reason"
      ],
      "title": "StartNodeChoice",
      "type": "object"
    },
    "ExplorerOutput": {
      "properties": {
        "start_nodes": {
          "items": {
            "$ref": "#/$defs/StartNodeChoice"
          },
          "title": "Start Nodes",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "hops_used": {
          "description": "실제 사용한 hop 수 (≤ PlannerOutput.max_hops)",
          "maximum": 3,
          "minimum": 1,
          "title": "Hops Used",
          "type": "integer"
        },
        "hop_extension_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1hop 초과 확장 시 근거",
          "title": "Hop Extension Reason"
        },
        "tool_call_count": {
          "default": 0,
          "title": "Tool Call Count",
          "type": "integer"
        }
      },
      "required": [
        "start_nodes",
        "nodes",
        "edges",
        "hops_used"
      ],
      "title": "ExplorerOutput",
      "type": "object"
    },
    "FollowupType": {
      "enum": [
        "business_answer",
        "developer_opinion",
        "query_result",
        "change_analysis",
        "reanalysis"
      ],
